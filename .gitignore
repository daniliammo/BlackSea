# ── Артефакты сборки в rootfs ─────────────────────────────────────────────────
# Принцип: в гите только ИСХОДНИКИ (конфиги, скрипты, данные). Ни ELF-бинарников,
# ни .so, ни busybox-symlink'ов, ни кэшей. Всё это порождается сборкой (оркестратор
# «Сборка» + скрипты образа) и заново раскладывается в rootfs локально.
#
# ВАЖНО: git НЕ понимает inline-комментарии — «#» работает только в НАЧАЛЕ строки.
# Комментарий в конце паттерна («/rootfs/bin/*  # …») делает его частью паттерна,
# и правило перестаёт срабатывать. Поэтому все пояснения — на отдельных строках.
#
# собранное ядро
/boot/bzImage
# генерит ldconfig в создать_образ.sh
/rootfs/etc/ld.so.cache
# кастомный init (субмодуль Инициализация) в /sbin/init + applet-symlink'и busybox
/rootfs/sbin/*
# busybox-applet'ы, weston и прочие ELF
/rootfs/bin/*
# только .so
/rootfs/lib/*
# .so + ld-linux
/rootfs/lib64/*
# weston-бинарники, хелперы и модули (.so уже покрыты глобально)
/rootfs/usr/local/bin/*
/rootfs/usr/local/sbin/*
/rootfs/usr/local/libexec/*
/rootfs/usr/local/lib/*
# рантайм-кэши (fontconfig и пр.), генерятся на лету
/rootfs/var/
# Исходные скрипты, лежащие среди артефактов, — сохраняем:
!/rootfs/bin/run-weston
!/rootfs/bin/ldd

# .gitkeep сохраняют САМИ каталоги (git не хранит пустые папки). Иначе на свежем
# клоне/в CI каталогов lib64, sbin, usr/local/{bin,lib,libexec} не будет, и сборка
# упадёт при копировании в них: копировать_файл не делает mkdir → «не открыть
# файл назначения». Правило-исключение возвращает .gitkeep из-под /rootfs/…/*.
!.gitkeep
