#!/bin/sh
# Запуск weston на минимальной системе: единственный пользователь root,
# без systemd / logind / dbus.
#
# Почему так:
#   * seatd — это ДЕМОН, он должен быть запущен и создать /run/seatd.sock ДО
#     weston. Без запущенного демона libseat не находит сокет и падает в logind,
#     а logind без systemd-сессии даёт «Could not get primary session».
#   * Для системы, где всё под root, проще всего встроенный (builtin) бэкенд
#     libseat: weston сам открывает DRM/ввод напрямую, без демона и без logind.
#
# Если позже понадобится seatd (например, запуск не от root) — запусти демон
# перед weston:  seatd -g video &   и убери строку LIBSEAT_BACKEND ниже.

set -eu

# XDG_RUNTIME_DIR обязателен для weston (сокет wayland, временные файлы).
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

# /dev/pts — псевдотерминалы для weston-terminal (forkpty). Создаём и монтируем
# здесь, а не в /etc/profile: init запускает не-login sh, профиль не читается.
# И статически /dev/pts не положить — devtmpfs перекрывает /dev и прячет его.
[ -d /dev/pts ] || mkdir -p /dev/pts
mountpoint -q /dev/pts 2>/dev/null || \
    mount -t devpts devpts /dev/pts -o gid=5,mode=620,ptmxmode=666 2>/dev/null || true

# Встроенный бэкенд libseat: без демона seatd и без logind (нужен root).
export LIBSEAT_BACKEND=builtin

# --renderer=pixman: программный рендер через DRM dumb-буферы, без Mesa/GBM/EGL.
# Дублирует настройку из /etc/xdg/weston/weston.ini (на случай, если конфиг не
# подхватится). Для GPU-ускорения убери флаг и доложи модули Mesa (libgallium,
# libLLVM, dri/*, gbm/dri_gbm.so) в rootfs.
exec weston --renderer=pixman "$@"
